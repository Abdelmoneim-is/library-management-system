@model IEnumerable<Admin.Dashboard.ViewModels.AuthorFormViewModel>

@{
    ViewData["Title"] = "Authors Management";
    var currentAuthorName = ViewData["CurrentAuthorName"] as string;
    var currentNationality = ViewData["CurrentNationality"] as string;
}

<div class="lib-page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="lib-page-title">Authors</h1>
        <p class="lib-page-subtitle">Manage library authors and writers</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
        <a asp-action="Create" class="btn btn-primary" style="background-color: #2c3e50; border-color: #2c3e50;">
            <i class="fas fa-plus me-1"></i> Add New Author
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-user text-muted"></i></span>
                    <input type="text" name="authorName" value="@currentAuthorName" class="form-control" placeholder="Search by author name..." />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-globe text-muted"></i></span>
                    <input type="text" name="nationality" value="@currentNationality" class="form-control" placeholder="Filter by nationality..." />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4" style="background-color: #2c3e50;">
                    <i class="fas fa-filter me-1"></i> Apply Filters
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="fas fa-redo me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-feather-alt me-1"></i> Authors List
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Author Name</th>
                        <th>Nationality</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var author in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Books" asp-action="Index" asp-route-authorId="@author.Id" class="fw-semibold text-decoration-none" title="View books by this author">
                                        @author.FullName
                                    </a>
                                </td>
                                <td>
                                    <a asp-action="Index" asp-route-nationality="@author.Nationality" class="text-muted text-decoration-none" title="Filter by this nationality">
                                        @(author.Nationality ?? "N/A")
                                    </a>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm px-3" style="color: #df9b00; border: 2px solid #f0ad4e; font-weight: 600; background-color: transparent;">Edit</a>

                                        <!-- 🛠️ تم تعديل الـ Form لتوجيه الطلب للكونترولر الصحيح Authors -->
                                        <form asp-controller="Authors" asp-action="Delete" asp-route-id="@author.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this author?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm px-3" style="color: #c9302c; border: 2px solid #d9534f; font-weight: 600; background-color: transparent;">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No authors found matching your criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>