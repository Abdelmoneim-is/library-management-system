@using LibraryApplication.Dtos.Identity
@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Library Admin Dashboard Login" />
    <meta name="author" content="" />
    <title>Login - Library Admin Dashboard</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <!-- FontAwesome Icons -->
    <script src="https://use.fontawesome.com/releases/v6.1.0/js/all.js" crossorigin="anonymous"></script>

    <style>
        body {
            background: linear-gradient(135deg, #2c3e50 0%, #1a252f 100%);
            height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3) !important;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #2c3e50;
            font-weight: 600;
        }

        .btn-custom {
            background-color: #2c3e50;
            border-color: #2c3e50;
            color: #fff;
            transition: all 0.3s ease;
        }

            .btn-custom:hover {
                background-color: #34495e;
                border-color: #34495e;
                color: #fff;
                transform: translateY(-1px);
            }
    </style>
</head>
<body class="d-flex align-items-center py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card p-4">
                    <div class="card-body">

                        <!-- Header / Logo Area -->
                        <div class="text-center mb-4">
                            <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 65px; height: 65px; font-size: 1.6rem; background-color: #2c3e50 !important;">
                                <i class="fas fa-book-reader"></i>
                            </div>
                            <h3 class="fw-bold text-dark m-0">Library Admin</h3>
                            <p class="text-muted small mt-1">Sign in to manage the system</p>
                        </div>

                        <!-- Error / Validation Summary -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                                <i class="fas fa-exclamation-circle me-1"></i> Invalid credentials or missing fields.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Login Form -->
                        <form method="post" asp-action="Login">

                            <div class="form-floating mb-3">
                                <input asp-for="@Model.Email" class="form-control rounded-3" id="inputEmail" type="email" placeholder="name@example.com" required />
                                <label asp-for="@Model.Email" for="inputEmail">
                                    <i class="fas fa-envelope me-1 text-muted"></i> Email address
                                </label>
                                <span asp-validation-for="@Model.Email" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="@Model.Password" class="form-control rounded-3" id="inputPassword" type="password" placeholder="Password" required />
                                <label asp-for="@Model.Password" for="inputPassword">
                                    <i class="fas fa-lock me-1 text-muted"></i> Password
                                </label>
                                <span asp-validation-for="@Model.Password" class="text-danger small"></span>
                            </div>

                            <div class="d-grid mt-4">
                                <button class="btn btn-custom btn-lg fw-bold rounded-3 py-2 shadow-sm" type="submit">
                                    <i class="fas fa-sign-in-alt me-2"></i> Login
                                </button>
                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>