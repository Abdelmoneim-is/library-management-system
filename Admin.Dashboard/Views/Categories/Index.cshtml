@model IEnumerable<Admin.Dashboard.ViewModels.CategoryFormViewModel>

@{
    ViewData["Title"] = "Categories Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
}

<div class="lib-page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="lib-page-title">Categories</h1>
        <p class="lib-page-subtitle">Manage book categories and genres</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
        <a asp-action="Create" class="btn btn-primary" style="background-color: #2c3e50; border-color: #2c3e50;">
            <i class="fas fa-plus me-1"></i> Add New Category
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchQuery" value="@currentSearch" class="form-control" placeholder="Search category name or description..." />
                </div>
            </div>
            <div class="col-md-8 d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4" style="background-color: #2c3e50;">
                    <i class="fas fa-filter me-1"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Search">
                    <i class="fas fa-redo me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-tags me-1"></i> Categories List
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Books" asp-action="Index" asp-route-categoryId="@category.Id" class="fw-semibold text-decoration-none" title="View books in this category">
                                        @category.Name
                                    </a>
                                </td>
                                <td><span class="text-muted">@(category.Description ?? "N/A")</span></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm px-3" style="color: #df9b00; border: 2px solid #f0ad4e; font-weight: 600; background-color: transparent;">Edit</a>
                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@category.Id" />
                                            <button type="submit" class="btn btn-sm px-3" style="color: #c9302c; border: 2px solid #d9534f; font-weight: 600; background-color: transparent;">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No categories found matching your search.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>