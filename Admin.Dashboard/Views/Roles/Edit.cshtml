@model Admin.Dashboard.ViewModels.RoleViewModel
@{
    ViewData["Title"] = "Edit Role";
}

<div class="lib-page-header">
    <div>
        <h1 class="lib-page-title">Edit Role</h1>
        <p class="lib-page-subtitle">Update system security role details</p>
    </div>
</div>

<div class="card shadow-sm col-md-8 mx-auto">
    <div class="card-header bg-light">
        <i class="fas fa-edit me-1 text-warning"></i> Edit Role: @Model.RoleName
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <!-- الـ RoleId ثابت ومخفي، التعديل مقتصر على اسم الدور فقط -->
            <input type="hidden" asp-for="RoleId" />

            <div class="mb-3">
                <label asp-for="RoleName" class="form-label fw-semibold">Role Name</label>
                <input asp-for="RoleName" class="form-control" />
                <span asp-validation-for="RoleName" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left me-1"></i> Back to List
                </a>
                <button type="submit" class="btn btn-warning text-dark fw-semibold px-4" style="border: 1.5px solid #d39e00;">
                    <i class="fas fa-save me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>