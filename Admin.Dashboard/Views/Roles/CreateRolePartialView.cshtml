@model Admin.Dashboard.ViewModels.RoleViewModel

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light">
        <i class="fas fa-plus-circle me-1 text-primary"></i> Add New Role
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row align-items-end">
                <div class="col-md-9 mb-2 mb-md-0">
                    <label asp-for="RoleName" class="form-label fw-semibold">Role Name</label>
                    <input asp-for="RoleName" class="form-control" placeholder="e.g. Librarian, Supervisor..." />
                    <span asp-validation-for="RoleName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-save me-1"></i> Save Role
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>