@model Admin.Dashboard.ViewModels.RolesIndexViewModel

@{
    ViewData["Title"] = "Roles Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="lib-page-title">Roles Management</h1>
        <p class="lib-page-subtitle">Manage system roles and permissions</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- نموذج إضافة دور جديد -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
        <i class="fas fa-plus-circle me-1"></i> Add New Role
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-3 align-items-center">
            @Html.AntiForgeryToken()
            <div class="col-auto flex-grow-1">
                <input asp-for="NewRole.RoleName" class="form-control" placeholder="Enter role name (e.g. Librarian)..." />
                <span asp-validation-for="NewRole.RoleName" class="text-danger small"></span>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i> Create Role
                </button>
            </div>
        </form>
    </div>
</div>

<!-- شريط البحث الذكي للأدوار -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchQuery" value="@currentSearch" class="form-control" placeholder="Search role name..." />
                </div>
            </div>
            <div class="col-md-8 d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4" style="background-color: #2c3e50;">
                    <i class="fas fa-filter me-1"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Search">
                    <i class="fas fa-redo me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- جدول عرض الأدوار الحالية -->
<div class="card shadow-sm">
    <div class="card-header bg-secondary text-white">
        <i class="fas fa-shield-alt me-1"></i> System Roles List
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>Assigned Users Count</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Roles != null && Model.Roles.Any())
                    {
                        @foreach (var role in Model.Roles)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@role.RoleName</span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        <i class="fas fa-users me-1"></i> @role.UserCount Users
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@role.RoleId" class="btn btn-sm btn-outline-primary" title="Edit Role">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-roleId="@role.RoleId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this role?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Role">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No roles found matching your search.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}