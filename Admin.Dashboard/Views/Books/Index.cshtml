@model IEnumerable<Admin.Dashboard.ViewModels.BookIndexViewModel>

@{
    ViewData["Title"] = "Books Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentCategoryId = ViewData["CurrentCategoryId"] as int?;
    var currentAuthorId = ViewData["CurrentAuthorId"] as int?;
    var currentAvailability = ViewData["CurrentAvailability"] as string;

    var categoriesList = ViewBag.Categories as List<SelectListItem> ?? new List<SelectListItem>();
    var authorsList = ViewBag.Authors as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="lib-page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="lib-page-title">Books</h1>
        <p class="lib-page-subtitle">Manage library book catalog, ISBN, and available copies</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
        <a asp-action="Create" class="btn btn-primary" style="background-color: #2c3e50; border-color: #2c3e50;">
            <i class="fas fa-plus me-1"></i> Add New Book
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- شريط البحث والفلترة الشامل للكتب -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">

            <!-- البحث النصي الذكي -->
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchQuery" value="@currentSearch" class="form-control" placeholder="Search title, ISBN, desc..." />
                </div>
            </div>

            <!-- فلتر القسم (Category) -->
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in categoriesList)
                    {
                        if (currentCategoryId?.ToString() == cat.Value)
                        {
                            <option value="@cat.Value" selected="selected">@cat.Text</option>
                        }
                        else
                        {
                            <option value="@cat.Value">@cat.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- فلتر المؤلف (Author) -->
            <div class="col-md-3">
                <select name="authorId" class="form-select">
                    <option value="">All Authors</option>
                    @foreach (var author in authorsList)
                    {
                        if (currentAuthorId?.ToString() == author.Value)
                        {
                            <option value="@author.Value" selected="selected">@author.Text</option>
                        }
                        else
                        {
                            <option value="@author.Value">@author.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- فلتر التوفر (Availability) -->
            <div class="col-md-3">
                <select name="availability" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(currentAvailability) ? "selected" : null)">All Statuses</option>
                    <option value="available" selected="@(currentAvailability == "available" ? "selected" : null)">Available (In Stock)</option>
                    <option value="out-of-stock" selected="@(currentAvailability == "out-of-stock" ? "selected" : null)">Out of Stock</option>
                </select>
            </div>

            <!-- أزرار التحكم -->
            <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn btn-dark px-4" style="background-color: #2c3e50;">
                    <i class="fas fa-filter me-1"></i> Apply Filters
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="fas fa-redo me-1"></i> Reset
                </a>
            </div>

        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-book me-1"></i> Books Catalog
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="lib-empty py-5 text-center">
                <div class="lib-empty-icon mb-2" style="font-size: 2rem; color: #6c757d;"><i class="fas fa-book-open"></i></div>
                <div class="lib-empty-title fw-bold">No books found</div>
                <div class="text-muted">No books match your current search or filter criteria.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>ISBN</th>
                            <th>Author</th>
                            <th>Category</th>
                            <th>Available / Total</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@book.Title</span>
                                </td>
                                <td><span class="text-muted">@book.ISBN</span></td>
                                <td>
                                    <a asp-action="Index" asp-route-authorId="@book.AuthorId" class="text-decoration-none text-muted" title="Filter by this author">
                                        @book.AuthorName
                                    </a>
                                </td>
                                <td>
                                    <a asp-action="Index" asp-route-categoryId="@book.CategoryId" class="badge bg-secondary text-decoration-none" title="Filter by this category">
                                        @book.CategoryName
                                    </a>
                                </td>
                                <td>
                                    <span class="badge @(book.AvailableCopies > 0 ? "bg-success" : "bg-danger")">
                                        @book.AvailableCopies / @book.TotalCopies
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm px-3" style="color: #df9b00; border: 2px solid #f0ad4e; font-weight: 600; background-color: transparent;">
                                            Edit
                                        </a>
                                        <!-- 🛠️ تم تعديل نموذج الحذف هنا ليشير بوضوح للكونترولر والأكشن مع الـ ID -->
                                        <form asp-controller="Books" asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this book?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm px-3" style="color: #c9302c; border: 2px solid #d9534f; font-weight: 600; background-color: transparent;">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>