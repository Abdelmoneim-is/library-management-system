@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mb-4 text-warning">
                <i class="fas fa-exclamation-triangle fa-5x"></i>
            </div>
            <h1 class="display-4 fw-bold text-dark">404</h1>
            <h3 class="fw-semibold text-secondary mb-3">Oops! Page Not Found</h3>
            <p class="text-muted mb-4">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark px-4 py-2" style="background-color: #2c3e50;">
                <i class="fas fa-home me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>