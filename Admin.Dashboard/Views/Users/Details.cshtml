@model Admin.Dashboard.ViewModels.UserWithRolesViewModel

@{
    ViewData["Title"] = "User Details";
}

<div class="lib-page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="lib-page-title">User Details</h1>
        <p class="lib-page-subtitle">Detailed information for @Model.UserName</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <i class="fas fa-user-circle me-1"></i> Account Information
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="fw-bold text-muted">User ID:</label>
                    <p class="form-control-plaintext">@Model.Id</p>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-muted">Username:</label>
                    <p class="form-control-plaintext fw-semibold">@Model.UserName</p>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-muted">Email Address:</label>
                    <p class="form-control-plaintext">@Model.Email</p>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-muted">Phone Number:</label>
                    <p class="form-control-plaintext">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</p>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-muted">Assigned Roles:</label>
                    <div class="mt-1">
                        @if (Model.Roles != null && Model.Roles.Any())
                        {
                            @foreach (var role in Model.Roles)
                            {
                                <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") fs-6 me-1">@role</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">No Role Assigned</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>