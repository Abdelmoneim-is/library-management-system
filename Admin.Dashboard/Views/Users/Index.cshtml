@model IEnumerable<Admin.Dashboard.ViewModels.UserWithRolesViewModel>

@{
    ViewData["Title"] = "Users Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentRole = ViewData["CurrentRole"] as string;
}

<div class="lib-page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="lib-page-title">Users</h1>
        <p class="lib-page-subtitle">Manage system users and their assigned roles</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
        <a asp-action="Create" class="btn btn-primary" style="background-color: #2c3e50; border-color: #2c3e50;">
            <i class="fas fa-user-plus me-1"></i> Add New User
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchQuery" value="@currentSearch" class="form-control" placeholder="Search username, email, or phone..." />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-user-shield text-muted"></i></span>
                    <select name="roleName" asp-items="ViewBag.RolesList" class="form-select">
                        <option value="">-- All Roles --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4" style="background-color: #2c3e50;">
                    <i class="fas fa-filter me-1"></i> Apply Filters
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="fas fa-redo me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-dark text-white">
        <i class="fas fa-users me-1"></i> System Users List
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Phone Number</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-initial rounded-circle bg-secondary text-white me-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; font-weight: bold;">
                                            @user.UserName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold">@user.UserName</span>
                                    </div>
                                </td>
                                <td><span class="text-muted">@user.Email</span></td>
                                <td>
                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        @foreach (var role in user.Roles)
                                        {
                                            <a asp-action="Index" asp-route-roleName="@role" class="badge text-decoration-none @(role == "Admin" ? "bg-danger" : "bg-primary") me-1" title="Filter by @role">
                                                @role
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Role</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "N/A" : user.PhoneNumber)</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="EditRoles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning" title="Manage Roles">
                                            <i class="fas fa-user-shield"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete User">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No users found matching your search.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>